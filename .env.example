# Environment configuration
HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
ALLOWED_ORIGINS=http://localhost

# Database configuration (Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_password
POSTGRES_DB=weather_db
POSTGRES_TIMEOUT=5s

# Test Database configuration
POSTGRES_HOST_TEST=localhost
POSTGRES_PORT_TEST=5433
POSTGRES_USER_TEST=weather_user_test
POSTGRES_PASSWORD_TEST=weather_password_test
POSTGRES_DB_TEST=weather_db_test

# Logger configuration
LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=out/logs

# Session configuration
SESSION_TTL=24h

# OpenWeather API configuration
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_REQUESTS_PER_MINUTE=60
OPENWEATHER_QUEUE_SIZE=100
