# Environment configuration
HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_ALLOWED_ORIGINS=http://localhost

# HTTP server timeouts (protection against slow clients and resource exhaustion)
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# Request limits
HTTP_MAX_BODY_BYTES=1048576           # 1MB - maximum request body size
HTTP_REQUEST_DEADLINE=25s             # Total deadline for request (DB + queue + upstream)
HTTP_MAX_CONCURRENT_REQUESTS=500      # Maximum concurrent requests (load shedding threshold)

# Cookie configuration
COOKIE_SECURE=false

# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_password
POSTGRES_DB=weather_db
POSTGRES_SSL_MODE=disable
POSTGRES_TIMEOUT=5s

# Logger configuration
LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=out/logs

# Session configuration
SESSION_TTL=24h
SESSION_CLEANUP_INTERVAL=10h

# OpenWeather API configuration
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_REQUESTS_PER_MINUTE=60
OPENWEATHER_QUEUE_SIZE=100

# TimeZone configuration
TIME_ZONE=UTC
