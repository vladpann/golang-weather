# Общий лимит на API: 10 запросов/сек с одного IP
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

# Жёсткий лимит на sign-in / sign-up: 5 запросов/мин с одного IP
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

# Лимит одновременных соединений с одного IP
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# Отвечать 429 вместо 503
limit_req_status  429;
limit_conn_status 429;
limit_req_log_level  warn;
limit_conn_log_level warn;

server {
    listen 80;
    server_name 77.223.99.64;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name 77.223.99.64;

    ssl_certificate     /etc/letsencrypt/live/77.223.99.64/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/77.223.99.64/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;

    root /usr/share/nginx/html;
    index index.html;

    # Logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Page 404
    error_page 404 /page-not-found.html;

    location = /page-not-found.html {
        internal;
    }

    # Ответ на превышение лимита (с Retry-After)
    error_page 429 = @too_many_requests;

    location @too_many_requests {
        internal;
        add_header Retry-After 60 always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type application/json;
        return 429 '{"error":"too many requests"}';
    }

    # Main Page
    location = / {
        try_files /index.html =404;
    }

    # Other files
    location / {
        try_files $uri $uri/ =404;
    }

    # API: строгий лимит на sign-in / sign-up
    # (регулярное выражение имеет приоритет над префиксом /api/)
    location ~ ^/api/v1/auth/(sign-in|sign-up)$ {
        limit_req zone=auth_limit burst=5 nodelay;
        limit_conn conn_limit 10;

        proxy_pass http://weather:5050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # API: остальные ручки
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_conn conn_limit 20;

        proxy_pass http://weather:5050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}