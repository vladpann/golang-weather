server {
    listen 80;
    server_name 77.223.99.64;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name 77.223.99.64;

    ssl_certificate     /etc/letsencrypt/live/77.223.99.64/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/77.223.99.64/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;

    root /usr/share/nginx/html;
    index index.html;

    # Page 404
    error_page 404 /page-not-found.html;

    location = /page-not-found.html {
        internal;
    }

    # Main Page
    location = / {
        try_files /index.html =404;
    }

    # Other files
    location / {
        try_files $uri $uri/ =404;
    }

    # Logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location /api/ {
        proxy_pass http://weather:5050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}