package locations_transport_http_test

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	"go.uber.org/zap"

	"github.com/vladpann/backend/golang-weather/internal/core/domain"
	core_logger "github.com/vladpann/backend/golang-weather/internal/core/logger"
	core_http_middleware "github.com/vladpann/backend/golang-weather/internal/core/transport/http/middleware"
	locations_repository_postgres "github.com/vladpann/backend/golang-weather/internal/features/locations/repository/postgres"
	locations_service "github.com/vladpann/backend/golang-weather/internal/features/locations/service"
	locations_transport_http "github.com/vladpann/backend/golang-weather/internal/features/locations/transport/http"
	users_repository_postgres "github.com/vladpann/backend/golang-weather/internal/features/users/repository/postgres"
	users_service "github.com/vladpann/backend/golang-weather/internal/features/users/service"
	"github.com/vladpann/backend/golang-weather/internal/testutil"
)

type testEnv struct {
	handler          *locations_transport_http.LocationsHTTPHandler
	locationsService *locations_service.LocationsService
	usersService     *users_service.UsersService
	logger           *core_logger.Logger
}

func setupTestEnv(t *testing.T) *testEnv {
	t.Helper()

	pool := testutil.SetupTestDB(t)
	t.Cleanup(func() { testutil.CleanupTestDB(t, pool) })

	// Инициализация dependencies
	locationsRepository := locations_repository_postgres.NewLocationsRepository(pool)
	locationsService := locations_service.NewLocationsService(locationsRepository)

	usersRepository := users_repository_postgres.NewUsersRepository(pool)
	passwordHasher := users_service.NewPasswordHasher()
	usersService := users_service.NewUsersService(usersRepository, passwordHasher)

	// Mock auth middleware - не используется, т.к. мы добавляем userID в контекст напрямую
	authMiddleware := func(next http.Handler) http.Handler {
		return next
	}

	handler := locations_transport_http.NewLocationsHTTPHandler(
		locationsService,
		authMiddleware,
	)

	zapLogger, err := zap.NewDevelopment()
	require.NoError(t, err)

	return &testEnv{
		handler:          handler,
		locationsService: locationsService,
		usersService:     usersService,
		logger:           &core_logger.Logger{Logger: zapLogger},
	}
}

// withAuth добавляет userID в контекст для эмуляции аутентификации
func withAuth(ctx context.Context, userID int64) context.Context {
	return context.WithValue(ctx, core_http_middleware.UserIDContextKey, userID)
}

func TestLocationsHTTPHandler_CreateLocation(t *testing.T) {
	env := setupTestEnv(t)

	t.Run("успешное создание локации с авторизацией", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		// Создаем пользователя
		ctx := context.Background()
		user, err := env.usersService.CreateUser(ctx, "locuser1", "password123", "password123")
		require.NoError(t, err)

		// Создаем локацию через HTTP
		reqBody := map[string]interface{}{
			"name":      "Moscow",
			"latitude":  55.7558,
			"longitude": 37.6173,
		}

		body, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/locations", bytes.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user.ID)) // Mock аутентификации

		// Добавляем userID в контекст напрямую
		ctx = context.WithValue(ctx, core_http_middleware.UserIDContextKey, user.ID)
		ctx = core_logger.ToContext(ctx, env.logger)
		req = req.WithContext(ctx)

		rr := httptest.NewRecorder()
		env.handler.CreateLocation(rr, req)

		// Проверка
		assert.Equal(t, http.StatusCreated, rr.Code)

		var response domain.Location
		err = json.NewDecoder(rr.Body).Decode(&response)
		require.NoError(t, err)

		assert.NotZero(t, response.ID)
		assert.Equal(t, "Moscow", response.Name)
		assert.Equal(t, 55.7558, response.Latitude)
		assert.Equal(t, 37.6173, response.Longitude)
		assert.Equal(t, user.ID, response.UserID)
	})

	t.Run("создание локации без авторизации возвращает 401", func(t *testing.T) {
		reqBody := map[string]interface{}{
			"name":      "Paris",
			"latitude":  48.8566,
			"longitude": 2.3522,
		}

		body, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/locations", bytes.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		// Не устанавливаем X-User-ID
		req = req.WithContext(core_logger.ToContext(context.Background(), env.logger))

		rr := httptest.NewRecorder()
		env.handler.CreateLocation(rr, req)

		assert.Equal(t, http.StatusUnauthorized, rr.Code)
	})

	t.Run("создание дубликата локации возвращает ошибку", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		ctx := context.Background()
		user, err := env.usersService.CreateUser(ctx, "dupuser", "password123", "password123")
		require.NoError(t, err)

		// Создаем первую локацию
		location := domain.NewLocation(0, user.ID, "Berlin", 52.5200, 13.4050)
		_, err = env.locationsService.CreateLocation(ctx, location)
		require.NoError(t, err)

		// Пытаемся создать дубликат через HTTP
		reqBody := map[string]interface{}{
			"name":      "Berlin City",
			"latitude":  52.5200,
			"longitude": 13.4050,
		}

		body, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/locations", bytes.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user.ID))
		req = req.WithContext(core_logger.ToContext(ctx, env.logger))

		rr := httptest.NewRecorder()
		env.handler.CreateLocation(rr, req)

		assert.Equal(t, http.StatusConflict, rr.Code)
	})

	t.Run("создание локации с невалидным JSON возвращает 400", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodPost, "/locations", bytes.NewReader([]byte(`{invalid`)))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("X-User-ID", "1")
		req = req.WithContext(core_logger.ToContext(context.Background(), env.logger))

		rr := httptest.NewRecorder()
		env.handler.CreateLocation(rr, req)

		assert.Equal(t, http.StatusBadRequest, rr.Code)
	})
}

func TestLocationsHTTPHandler_GetLocations(t *testing.T) {
	env := setupTestEnv(t)

	t.Run("получение списка локаций для пользователя", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		ctx := context.Background()
		user, err := env.usersService.CreateUser(ctx, "listuser", "password123", "password123")
		require.NoError(t, err)

		// Создаем несколько локаций
		locations := []domain.Location{
			domain.NewLocation(0, user.ID, "Tokyo", 35.6762, 139.6503),
			domain.NewLocation(0, user.ID, "New York", 40.7128, -74.0060),
		}

		for _, loc := range locations {
			_, err := env.locationsService.CreateLocation(ctx, loc)
			require.NoError(t, err)
		}

		// Запрашиваем список через HTTP
		req := httptest.NewRequest(http.MethodGet, "/locations", nil)
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user.ID))
		req = req.WithContext(core_logger.ToContext(ctx, env.logger))

		rr := httptest.NewRecorder()
		env.handler.GetLocations(rr, req)

		// Проверка
		assert.Equal(t, http.StatusOK, rr.Code)

		var response []map[string]interface{}
		err = json.NewDecoder(rr.Body).Decode(&response)
		require.NoError(t, err)

		assert.Len(t, response, 2, "должно быть 2 локации")
	})

	t.Run("пользователь видит только свои локации", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		ctx := context.Background()
		user1, _ := env.usersService.CreateUser(ctx, "user1", "password123", "password123")
		user2, _ := env.usersService.CreateUser(ctx, "user2", "password123", "password123")

		// user1 создает локацию
		loc1 := domain.NewLocation(0, user1.ID, "London", 51.5074, -0.1278)
		_, err := env.locationsService.CreateLocation(ctx, loc1)
		require.NoError(t, err)

		// user2 создает локацию
		loc2 := domain.NewLocation(0, user2.ID, "Rome", 41.9028, 12.4964)
		_, err = env.locationsService.CreateLocation(ctx, loc2)
		require.NoError(t, err)

		// user1 запрашивает свои локации
		req := httptest.NewRequest(http.MethodGet, "/locations", nil)
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user1.ID))
		req = req.WithContext(core_logger.ToContext(ctx, env.logger))

		rr := httptest.NewRecorder()
		env.handler.GetLocations(rr, req)

		assert.Equal(t, http.StatusOK, rr.Code)

		var response []map[string]interface{}
		err = json.NewDecoder(rr.Body).Decode(&response)
		require.NoError(t, err)

		assert.Len(t, response, 1, "user1 должен видеть только свою локацию")
		assert.Equal(t, "London", response[0]["name"])
	})

	t.Run("получение локаций без авторизации возвращает 401", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodGet, "/locations", nil)
		// Не устанавливаем X-User-ID
		req = req.WithContext(core_logger.ToContext(context.Background(), env.logger))

		rr := httptest.NewRecorder()
		env.handler.GetLocations(rr, req)

		assert.Equal(t, http.StatusUnauthorized, rr.Code)
	})

	t.Run("пагинация с limit", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		ctx := context.Background()
		user, _ := env.usersService.CreateUser(ctx, "paginuser", "password123", "password123")

		// Создаем 5 локаций
		for i := 0; i < 5; i++ {
			loc := domain.NewLocation(0, user.ID, fmt.Sprintf("City%d", i), float64(i), float64(i))
			_, err := env.locationsService.CreateLocation(ctx, loc)
			require.NoError(t, err)
		}

		// Запрашиваем с limit=2
		req := httptest.NewRequest(http.MethodGet, "/locations?limit=2", nil)
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user.ID))
		req = req.WithContext(core_logger.ToContext(ctx, env.logger))

		rr := httptest.NewRecorder()
		env.handler.GetLocations(rr, req)

		assert.Equal(t, http.StatusOK, rr.Code)

		var response []map[string]interface{}
		err := json.NewDecoder(rr.Body).Decode(&response)
		require.NoError(t, err)

		assert.Len(t, response, 2, "должно быть возвращено 2 локации")
	})
}

func TestLocationsHTTPHandler_DeleteLocation(t *testing.T) {
	env := setupTestEnv(t)

	t.Run("успешное удаление локации", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		ctx := context.Background()
		user, _ := env.usersService.CreateUser(ctx, "deluser", "password123", "password123")

		// Создаем локацию
		location := domain.NewLocation(0, user.ID, "Vienna", 48.2082, 16.3738)
		created, err := env.locationsService.CreateLocation(ctx, location)
		require.NoError(t, err)

		// Удаляем через HTTP
		req := httptest.NewRequest(http.MethodDelete, fmt.Sprintf("/locations/%d", created.ID), nil)
		req.SetPathValue("id", fmt.Sprintf("%d", created.ID))
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user.ID))
		req = req.WithContext(core_logger.ToContext(ctx, env.logger))

		rr := httptest.NewRecorder()
		env.handler.DeleteLocation(rr, req)

		assert.Equal(t, http.StatusNoContent, rr.Code)

		// Проверяем, что локация удалена
		_, err = env.locationsService.GetLocation(ctx, created.ID, user.ID)
		assert.Error(t, err, "локация должна быть удалена")
	})

	t.Run("удаление несуществующей локации возвращает 404", func(t *testing.T) {
		testutil.ClearTables(t, testutil.SetupTestDB(t))

		ctx := context.Background()
		user, _ := env.usersService.CreateUser(ctx, "user", "password123", "password123")

		req := httptest.NewRequest(http.MethodDelete, "/locations/99999", nil)
		req.SetPathValue("id", "99999")
		req.Header.Set("X-User-ID", fmt.Sprintf("%d", user.ID))
		req = req.WithContext(core_logger.ToContext(ctx, env.logger))

		rr := httptest.NewRecorder()
		env.handler.DeleteLocation(rr, req)

		assert.Equal(t, http.StatusNotFound, rr.Code)
	})

	t.Run("удаление без авторизации возвращает 401", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodDelete, "/locations/1", nil)
		req.SetPathValue("id", "1")
		// Не устанавливаем X-User-ID
		req = req.WithContext(core_logger.ToContext(context.Background(), env.logger))

		rr := httptest.NewRecorder()
		env.handler.DeleteLocation(rr, req)

		assert.Equal(t, http.StatusUnauthorized, rr.Code)
	})

	t.Run("удаление с невалидным ID возвращает 400", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodDelete, "/locations/invalid", nil)
		req.SetPathValue("id", "invalid")
		req.Header.Set("X-User-ID", "1")
		req = req.WithContext(core_logger.ToContext(context.Background(), env.logger))

		rr := httptest.NewRecorder()
		env.handler.DeleteLocation(rr, req)

		assert.Equal(t, http.StatusBadRequest, rr.Code)
	})
}

func TestLocationsHTTPHandler_Routes(t *testing.T) {
	env := setupTestEnv(t)

	routes := env.handler.Routes()

	t.Run("должно быть 3 маршрута", func(t *testing.T) {
		assert.Len(t, routes, 3)
	})

	t.Run("POST /locations с middleware", func(t *testing.T) {
		route := routes[0]
		assert.Equal(t, http.MethodPost, route.Method)
		assert.Equal(t, "/locations", route.Path)
		assert.NotNil(t, route.Handler)
		assert.Len(t, route.Middlewares, 1, "требует аутентификации")
	})

	t.Run("GET /locations с middleware", func(t *testing.T) {
		route := routes[1]
		assert.Equal(t, http.MethodGet, route.Method)
		assert.Equal(t, "/locations", route.Path)
		assert.NotNil(t, route.Handler)
		assert.Len(t, route.Middlewares, 1, "требует аутентификации")
	})

	t.Run("DELETE /locations/{id} с middleware", func(t *testing.T) {
		route := routes[2]
		assert.Equal(t, http.MethodDelete, route.Method)
		assert.Equal(t, "/locations/{id}", route.Path)
		assert.NotNil(t, route.Handler)
		assert.Len(t, route.Middlewares, 1, "требует аутентификации")
	})
}
