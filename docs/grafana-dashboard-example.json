{
  "dashboard": {
    "title": "Weather App - Metrics Overview",
    "panels": [
      {
        "title": "HTTP Request Rate",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (method, status_class)",
            "legendFormat": "{{method}} {{status_class}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "HTTP P95 Latency",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (method, le))",
            "legendFormat": "P95 {{method}}"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (method, le))",
            "legendFormat": "P50 {{method}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "HTTP Requests In-Flight",
        "targets": [
          {
            "expr": "http_requests_in_flight"
          }
        ],
        "type": "gauge"
      },
      {
        "title": "Upstream API Request Rate",
        "targets": [
          {
            "expr": "sum(rate(upstream_requests_total[5m])) by (endpoint_group, status)",
            "legendFormat": "{{endpoint_group}} - {{status}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Upstream API Error Rate",
        "targets": [
          {
            "expr": "sum(rate(upstream_errors_total[5m])) by (endpoint_group, error_type)",
            "legendFormat": "{{endpoint_group}} - {{error_type}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Upstream API P95 Latency",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(upstream_request_duration_seconds_bucket[5m])) by (endpoint_group, le))",
            "legendFormat": "P95 {{endpoint_group}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Queue Depth",
        "targets": [
          {
            "expr": "queue_depth"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Queue Wait Time P95",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(queue_wait_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(queue_wait_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Queue Rejections Rate",
        "targets": [
          {
            "expr": "rate(queue_rejections_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Memory Usage",
        "targets": [
          {
            "expr": "go_memstats_alloc_bytes",
            "legendFormat": "Allocated"
          },
          {
            "expr": "go_memstats_heap_inuse_bytes",
            "legendFormat": "Heap In Use"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Goroutines",
        "targets": [
          {
            "expr": "go_goroutines"
          }
        ],
        "type": "graph"
      },
      {
        "title": "GC Duration",
        "targets": [
          {
            "expr": "rate(go_gc_duration_seconds_sum[5m]) / rate(go_gc_duration_seconds_count[5m])",
            "legendFormat": "Average GC Duration"
          }
        ],
        "type": "graph"
      }
    ]
  }
}
